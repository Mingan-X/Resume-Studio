# All image references must include reviewed immutable digests before a real release.
APP_IMAGE=<reviewed-application-image@sha256:digest>
NODE_IMAGE=<node-24.22.3-linux-image@sha256:digest>
DOCKER_CLI_IMAGE=<compatible-official-docker-cli-image@sha256:digest>
NGINX_IMAGE=<reviewed-official-nginx-image@sha256:digest>
PUBLIC_HOST=resume.example
RELEASE_SECRETS_DIR=/etc/resume-studio/release
STORAGE_DIRECTORY=/srv/resume-studio/storage
FRONTEND_DIST=/srv/resume-studio/frontend
