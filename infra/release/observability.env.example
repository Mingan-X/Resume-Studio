OBSERVABILITY_ENABLED=true
LANGFUSE_BASE_URL=http://127.0.0.1:53000
LANGFUSE_PUBLIC_KEY=<project-public-key>
LANGFUSE_SECRET_KEY=<project-secret-key>
# Non-secret placeholders for read-only Compose volume resolution, not provisioning.
LANGFUSE_POSTGRES_PASSWORD=unused-ownership-render-only
LANGFUSE_REDIS_PASSWORD=unused-ownership-render-only
LANGFUSE_CLICKHOUSE_PASSWORD=unused-ownership-render-only
LANGFUSE_S3_SECRET=unused-ownership-render-only
LANGFUSE_SALT=unused-ownership-render-only
LANGFUSE_ENCRYPTION_KEY=unused-ownership-render-only
LANGFUSE_NEXTAUTH_SECRET=unused-ownership-render-only
LANGFUSE_INIT_USER_EMAIL=unused@example.invalid
LANGFUSE_INIT_USER_PASSWORD=unused-ownership-render-only
