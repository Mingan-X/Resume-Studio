server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 308 https://${PUBLIC_HOST}$request_uri;
}
server {
    listen 443 ssl;
    server_name ${PUBLIC_HOST};
    if ($host != "${PUBLIC_HOST}") { return 444; }
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 11m;
    client_body_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    root /srv/www;
    location = /ready { return 404; }
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 320s;
        proxy_send_timeout 30s;
        proxy_hide_header Strict-Transport-Security;
    }
    location = /health { proxy_pass http://127.0.0.1:3000; }
    location = /index.html { expires -1; }
    location / { try_files $uri $uri/ /index.html; }
}
