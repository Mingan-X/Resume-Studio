# Copy outside the repository, restrict to the runtime UID, and fill actual values.
APP_ENV=production
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
AUTH_ENABLED=true
AUTH_ORIGIN=https://resume.example
TASK_API_ENABLED=true
RESUME_API_ENABLED=true
JOB_API_ENABLED=true
READINESS_ENABLED=true
INFRA_TEST_SCOPE=resume-studio-s12-test
DATABASE_URL=postgresql://resume_studio_test:<runtime-password>@127.0.0.1:55432/resume_studio_s12_test
RABBITMQ_URL=amqp://resume_studio_test:<runtime-password>@127.0.0.1:55672/resume-studio-s12-test?heartbeat=10
QDRANT_URL=http://127.0.0.1:56333
QDRANT_API_KEY=<runtime-key>
SERVICE_OWNER_ID=<existing-account-owner-uuid>
STORAGE_ROOT=/srv/resume-studio/storage
ANALYSIS_CONFIG_FILE=/run/models/analysis.json
ANALYSIS_MODEL_CONFIG_FILE=/run/models/model.json
JOB_MODEL_CONFIG_FILE=/run/models/model.json
JOB_INDEX_TARGET_FILE=/run/models/index-target.json
JOB_EMBEDDING_CONFIG_FILE=/run/models/embedding.json
# Used ONLY to render the committed Compose file during read-only ownership checks.
# Do not place administrator passwords in application containers or run provision here.
POSTGRES_ADMIN_PASSWORD=unused-ownership-render-only
RABBITMQ_PASSWORD=unused-ownership-render-only
