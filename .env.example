# Non-secret local settings. Copy to .env before running start scripts.
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Enable task creation/query/cancel API only with the local project DATABASE_URL (see deployment docs).
TASK_API_ENABLED=false
RESUME_API_ENABLED=false
JOB_API_ENABLED=false
# Session mode is mandatory for production business routes; browser access needs same-origin HTTPS.
AUTH_ENABLED=false
# AUTH_ORIGIN=https://resume.example
# AUTH_SESSION_SECONDS=28800
# AUTH_ANONYMOUS_SECONDS=600
# Publication/reconciliation operator commands select a verified account owner explicitly.
# SERVICE_OWNER_ID=<account-owner-uuid>
# Optional absolute paths to ignored local JSON files; never commit actual keys.
# ANALYSIS_CONFIG_FILE=E:/Resume-Studio/Resume-Studio-Backend/data/analysis.local.json
# ANALYSIS_MODEL_CONFIG_FILE=E:/Resume-Studio/Resume-Studio-Backend/data/model.local.json
# JOB_MODEL_CONFIG_FILE=E:/Resume-Studio/Resume-Studio-Backend/data/model.local.json
# JOB_INDEX_TARGET_FILE=E:/Resume-Studio/Resume-Studio-Backend/data/index-target.local.json
# Set an absolute dedicated directory when enabling resume routes.
# STORAGE_ROOT=E:/Resume-Studio/Resume-Studio-Backend/data/resume-files
