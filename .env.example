# Non-secret local settings. Copy to .env before running start scripts.
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Enable task query/cancel API only with the local project DATABASE_URL (see deployment docs).
TASK_API_ENABLED=false
RESUME_API_ENABLED=false
# Set an absolute dedicated directory when enabling resume routes.
# STORAGE_ROOT=E:/Resume-Studio/Resume-Studio-Backend/data/resume-files
