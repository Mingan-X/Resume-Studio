generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Synthetic infrastructure diagnostics only, not the future business Task table.
model DiagnosticRecord {
  id        String   @id @db.Uuid
  runId     String   @map("run_id")
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@map("s12_diagnostic_record")
}

enum AnalysisTaskStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum JobIndexTaskStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TaskType {
  ANALYSIS
  JOB_INDEX
}

enum ReceiptStatus {
  RUNNING
  DONE
}

model Owner {
  id String @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  analysisTasks AnalysisTask[]
  jobIndexTasks JobIndexTask[]
  outboxEvents OutboxEvent[]
  quarantines Quarantine[]
  syntheticIndexTargets SyntheticIndexTarget[]
  fileAssets FileAsset[]
  resumes Resume[]
  jobs Job[]
  rubrics RubricVersion[]
  jobCorpora JobCorpusVersion[]
  analysisConfigurations AnalysisConfiguration[]

  @@map("owner")
}

// Immutable published-version manifest; skills retain their original dictionary snapshot.
model JobCorpusVersion {
  ownerId String @map("owner_id") @db.Uuid
  version String @db.VarChar(64)
  visibility String @db.VarChar(16)
  contentHash String @map("content_hash") @db.Char(64)
  manifest Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  candidateSets CandidateSet[]
  analysisTasks AnalysisTask[]

  @@id([ownerId, version])
  @@map("job_corpus_version")
}

model FileAsset {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storageKey String @unique @map("storage_key") @db.Uuid
  sha256 String @db.Char(64)
  mime String @db.VarChar(128)
  size Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  versions ResumeVersion[]
  @@unique([ownerId, id, sha256])
  @@map("file_asset")
}

model Resume {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  versions ResumeVersion[]
  @@unique([ownerId, id])
  @@index([ownerId, createdAt, id])
  @@map("resume")
}

model ResumeVersion {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  resumeId String @map("resume_id") @db.Uuid
  resume Resume @relation(fields: [ownerId, resumeId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  version Int
  fileAssetId String @map("file_asset_id") @db.Uuid
  fileHash String @map("file_hash") @db.Char(64)
  fileAsset FileAsset @relation(fields: [ownerId, fileAssetId, fileHash], references: [ownerId, id, sha256], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocks EvidenceBlock[]
  uploads ResumeUpload[]
  extractedDocument ExtractedDocument?
  analysisTasks AnalysisTask[]
  @@unique([resumeId, version])
  @@unique([ownerId, id])
  @@unique([ownerId, id, fileHash])
  @@map("resume_version")
}

model EvidenceBlock {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  sourceVersionId String @map("source_version_id") @db.Uuid
  resumeVersion ResumeVersion @relation(fields: [ownerId, sourceVersionId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  ordinal Int
  text String
  textHash String @map("text_hash") @db.Char(64)
  location Json @db.JsonB
  @@unique([sourceVersionId, ordinal])
  @@unique([ownerId, sourceVersionId, id])
  @@map("evidence_block")
}

model ResumeUpload {
  ownerId String @map("owner_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  fileHash String @map("file_hash") @db.Char(64)
  resumeVersionId String @map("resume_version_id") @db.Uuid
  resumeVersion ResumeVersion @relation(fields: [ownerId, resumeVersionId, fileHash], references: [ownerId, id, fileHash], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@id([ownerId, idempotencyKey])
  @@map("resume_upload")
}

model ExtractedDocument {
  sourceVersionId String @id @map("source_version_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  fileHash String @map("file_hash") @db.Char(64)
  resumeVersion ResumeVersion @relation(fields: [ownerId, sourceVersionId, fileHash], references: [ownerId, id, fileHash], onDelete: NoAction, onUpdate: NoAction)
  document Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([ownerId, sourceVersionId, fileHash])
  @@map("extracted_document")
}

// S1.4 version IDs refer to synthetic inputs; business version FKs arrive with S2.
model AnalysisTask {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  resumeVersionId String @map("resume_version_id") @db.Uuid
  realResumeVersionId String? @map("real_resume_version_id") @db.Uuid
  realResumeVersion ResumeVersion? @relation(fields: [ownerId, realResumeVersionId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  corpusVersion String? @map("corpus_version") @db.VarChar(64)
  corpus JobCorpusVersion? @relation(fields: [ownerId, corpusVersion], references: [ownerId, version], onDelete: NoAction, onUpdate: NoAction)
  rubricVersion String? @map("rubric_version") @db.VarChar(64)
  rubric RubricVersion? @relation(fields: [ownerId, rubricVersion], references: [ownerId, version], onDelete: NoAction, onUpdate: NoAction)
  configurationVersion String? @map("configuration_version") @db.VarChar(64)
  configuration AnalysisConfiguration? @relation(fields: [ownerId, configurationVersion], references: [ownerId, version], onDelete: NoAction, onUpdate: NoAction)
  activeGraphThreadId String @map("active_graph_thread_id") @db.Uuid
  graphGeneration Int @default(1) @map("graph_generation")
  reportId String? @map("report_id") @db.Uuid
  inputSnapshot Json @map("input_snapshot") @db.JsonB
  status AnalysisTaskStatus @default(QUEUED)
  recoveryCount Int @default(0) @map("recovery_count")
  retryAt DateTime? @map("retry_at")
  stage String @default("QUEUED") @db.VarChar(64)
  generation Int @default(1)
  fenceToken BigInt @default(0) @map("fence_token")
  leaseOwner String? @map("lease_owner") @db.Uuid
  leaseUntil DateTime? @map("lease_until")
  heartbeatAt DateTime? @map("heartbeat_at")
  cancelRequested Boolean @default(false) @map("cancel_requested")
  errorCode String? @map("error_code") @db.VarChar(64)
  budgetUsage Json @map("budget_usage") @db.JsonB
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  attempts TaskAttempt[]
  events TaskEvent[]
  receipts ConsumerReceipt[]
  artifacts NodeArtifact[]
  candidateSet CandidateSet?

  @@unique([ownerId, idempotencyKey])
  @@unique([ownerId, id])
  @@index([ownerId, status, createdAt])
  @@index([status, leaseUntil])
  @@index([ownerId, status, updatedAt])
  @@map("analysis_task")
}

// S1.4 version IDs refer to synthetic inputs; business version FKs arrive with S2.
model JobIndexTask {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  jobVersionId String @map("job_version_id") @db.Uuid
  realJobVersionId String? @map("real_job_version_id") @db.Uuid
  realJobVersion JobVersion? @relation(fields: [ownerId, realJobVersionId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  indexTargets JobIndexTarget[]
  indexRequests JobIndexRequest[]
  embeddingVersion String @map("embedding_version") @db.VarChar(64)
  indexVersion String @map("index_version") @db.VarChar(64)
  inputSnapshot Json @map("input_snapshot") @db.JsonB
  status JobIndexTaskStatus @default(QUEUED)
  recoveryCount Int @default(0) @map("recovery_count")
  retryAt DateTime? @map("retry_at")
  stage String @default("QUEUED") @db.VarChar(64)
  generation Int @default(1)
  fenceToken BigInt @default(0) @map("fence_token")
  leaseOwner String? @map("lease_owner") @db.Uuid
  leaseUntil DateTime? @map("lease_until")
  heartbeatAt DateTime? @map("heartbeat_at")
  cancelRequested Boolean @default(false) @map("cancel_requested")
  errorCode String? @map("error_code") @db.VarChar(64)
  budgetUsage Json @map("budget_usage") @db.JsonB
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  attempts TaskAttempt[]
  events TaskEvent[]
  receipts ConsumerReceipt[]
  artifacts NodeArtifact[]

  @@unique([ownerId, idempotencyKey])
  @@unique([ownerId, id])
  @@index([ownerId, status, createdAt])
  @@index([status, leaseUntil])
  @@index([ownerId, status, updatedAt])
  @@map("job_index_task")
}

model Job {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  versions JobVersion[]
  @@unique([ownerId, id])
  @@index([ownerId, createdAt, id])
  @@map("job")
}

model JobVersion {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  job Job @relation(fields: [ownerId, jobId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  version Int
  title String @db.VarChar(256)
  city String? @db.VarChar(128)
  level String? @db.VarChar(128)
  skills String[]
  document Json @db.JsonB
  dimensionWeights Json @map("dimension_weights") @db.JsonB
  hardRequirementsConfirmed Boolean @default(false) @map("hard_requirements_confirmed")
  weightsConfirmed Boolean @default(false) @map("weights_confirmed")
  status String @default("DRAFT") @db.VarChar(16)
  contentHash String? @map("content_hash") @db.Char(64)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  indexStatus String @default("NOT_REQUESTED") @map("index_status") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  requirements JobRequirement[]
  indexTasks JobIndexTask[]
  indexTarget JobIndexTarget?
  candidates Candidate[]
  @@unique([jobId, version])
  @@unique([ownerId, id])
  @@map("job_version")
}

model JobRequirement {
  ownerId String @map("owner_id") @db.Uuid
  jobVersionId String @map("job_version_id") @db.Uuid
  jobVersion JobVersion @relation(fields: [ownerId, jobVersionId], references: [ownerId, id], onDelete: Cascade, onUpdate: NoAction)
  stableId String @map("stable_id") @db.VarChar(128)
  ordinal Int
  requirement Json @db.JsonB
  @@id([jobVersionId, stableId])
  @@unique([jobVersionId, ordinal])
  @@index([ownerId, jobVersionId])
  @@map("job_requirement")
}

model RubricVersion {
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version String @db.VarChar(64)
  content Json @db.JsonB
  contentHash String @map("content_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  analysisTasks AnalysisTask[]
  @@id([ownerId, version])
  @@map("rubric_version")
}

model AnalysisConfiguration {
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version String @db.VarChar(64)
  content Json @db.JsonB
  contentHash String @map("content_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tasks AnalysisTask[]
  @@id([ownerId, version])
  @@map("analysis_configuration")
}

model JobIndexTarget {
  ownerId String @map("owner_id") @db.Uuid
  jobVersionId String @id @map("job_version_id") @db.Uuid
  jobVersion JobVersion @relation(fields: [ownerId, jobVersionId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  taskId String @map("task_id") @db.Uuid
  task JobIndexTask @relation(fields: [ownerId, taskId], references: [ownerId, id], onDelete: NoAction, onUpdate: NoAction)
  embeddingVersion String @map("embedding_version") @db.VarChar(64)
  indexVersion String @map("index_version") @db.VarChar(64)
  @@unique([ownerId, jobVersionId])
  @@map("job_index_target")
}

// A backfill request also persists when its target already exists (no new task).
model JobIndexRequest {
  ownerId String @map("owner_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  taskId String @map("task_id") @db.Uuid
  task JobIndexTask @relation(fields: [ownerId, taskId], references: [ownerId, id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([ownerId, idempotencyKey])
  @@index([ownerId, taskId])
  @@map("job_index_request")
}

model CandidateSet {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  taskId String @unique @map("task_id") @db.Uuid
  task AnalysisTask @relation(fields: [ownerId, taskId], references: [ownerId, id], onDelete: Restrict, onUpdate: NoAction)
  corpusVersion String @map("corpus_version") @db.VarChar(64)
  corpus JobCorpusVersion @relation(fields: [ownerId, corpusVersion], references: [ownerId, version], onDelete: Restrict, onUpdate: NoAction)
  status String @default("BUILDING") @db.VarChar(16)
  content Json @db.JsonB
  contentHash String @map("content_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  candidates Candidate[]
  @@unique([ownerId, id])
  @@unique([ownerId, taskId])
  @@map("candidate_set")
}

model Candidate {
  ownerId String @map("owner_id") @db.Uuid
  setId String @map("set_id") @db.Uuid
  set CandidateSet @relation(fields: [ownerId, setId], references: [ownerId, id], onDelete: Cascade, onUpdate: NoAction)
  jobVersionId String @map("job_version_id") @db.Uuid
  jobVersion JobVersion @relation(fields: [ownerId, jobVersionId], references: [ownerId, id], onDelete: Restrict, onUpdate: NoAction)
  rank Int
  content Json @db.JsonB
  @@id([setId, jobVersionId])
  @@unique([setId, rank])
  @@map("candidate")
}

// SQL CHECK enforces one matching task FK; composite FKs also enforce ownership.
model TaskAttempt {
  attemptId String @id @map("attempt_id") @db.Uuid
  generation Int
  fenceToken BigInt @map("fence_token")
  startedAt DateTime @default(now()) @map("started_at")
  endedAt DateTime? @map("ended_at")
  executionStoppedAt DateTime? @map("execution_stopped_at")
  traceId String? @map("trace_id") @db.Char(32)
  errorClass String? @map("error_class") @db.VarChar(64)
  tokens BigInt @default(0)
  costMicros BigInt @default(0) @map("cost_micros")
  currency String @db.Char(3)
  ownerId String @map("owner_id") @db.Uuid
  taskType TaskType @map("task_type")
  taskId String @map("task_id") @db.Uuid
  analysisTaskId String? @map("analysis_task_id") @db.Uuid
  jobIndexTaskId String? @map("job_index_task_id") @db.Uuid
  analysisTask AnalysisTask? @relation(fields: [ownerId, analysisTaskId], references: [ownerId, id], onDelete: Restrict)
  jobIndexTask JobIndexTask? @relation(fields: [ownerId, jobIndexTaskId], references: [ownerId, id], onDelete: Restrict)

  @@index([ownerId, taskType, taskId, startedAt])
  @@map("task_attempt")
}

// SQL CHECK enforces one matching task FK; composite FKs also enforce ownership.
model TaskEvent {
  id String @id @db.Uuid
  seq Int
  stage String @db.VarChar(64)
  counts Json @db.JsonB
  safeMessage String @map("safe_message") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at")
  ownerId String @map("owner_id") @db.Uuid
  taskType TaskType @map("task_type")
  taskId String @map("task_id") @db.Uuid
  analysisTaskId String? @map("analysis_task_id") @db.Uuid
  jobIndexTaskId String? @map("job_index_task_id") @db.Uuid
  analysisTask AnalysisTask? @relation(fields: [ownerId, analysisTaskId], references: [ownerId, id], onDelete: Restrict)
  jobIndexTask JobIndexTask? @relation(fields: [ownerId, jobIndexTaskId], references: [ownerId, id], onDelete: Restrict)

  @@unique([taskType, taskId, seq])
  @@index([ownerId, taskType, taskId, seq])
  @@map("task_event")
}

// SQL CHECK enforces one matching task FK; composite FKs also enforce ownership.
model ConsumerReceipt {
  id String @id @db.Uuid
  consumerName String @map("consumer_name") @db.VarChar(128)
  messageId String @map("message_id") @db.Uuid
  generation Int
  status ReceiptStatus @default(RUNNING)
  leaseOwner String? @map("lease_owner") @db.Uuid
  leaseUntil DateTime? @map("lease_until")
  processedAt DateTime? @map("processed_at")
  createdAt DateTime @default(now()) @map("created_at")
  ownerId String @map("owner_id") @db.Uuid
  taskType TaskType @map("task_type")
  taskId String @map("task_id") @db.Uuid
  analysisTaskId String? @map("analysis_task_id") @db.Uuid
  jobIndexTaskId String? @map("job_index_task_id") @db.Uuid
  analysisTask AnalysisTask? @relation(fields: [ownerId, analysisTaskId], references: [ownerId, id], onDelete: Restrict)
  jobIndexTask JobIndexTask? @relation(fields: [ownerId, jobIndexTaskId], references: [ownerId, id], onDelete: Restrict)

  @@unique([consumerName, messageId])
  @@index([ownerId, taskType, taskId])
  @@index([status, leaseUntil])
  @@map("consumer_receipt")
}

// Generic aggregate identity, deliberately no analysis-only task FK.
model OutboxEvent {
  eventId String @id @map("event_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  aggregateType String @map("aggregate_type") @db.VarChar(64)
  aggregateId String @map("aggregate_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(128)
  payloadVersion Int @map("payload_version")
  payload Json @db.JsonB
  availableAt DateTime @default(now()) @map("available_at")
  leaseOwner String? @map("lease_owner") @db.Uuid
  leaseUntil DateTime? @map("lease_until")
  publishAttempts Int @default(0) @map("publish_attempts")
  publishedAt DateTime? @map("published_at")
  failedAt DateTime? @map("failed_at")
  lastErrorCode String? @map("last_error_code") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([publishedAt, availableAt, leaseUntil])
  @@index([ownerId, aggregateType, aggregateId])
  @@index([ownerId, failedAt, publishedAt, availableAt])
  @@map("outbox_event")
}

// Invalid deliveries may have no valid UUID messageId or trusted owner.
model Quarantine {
  id String @id @db.Uuid
  // Trusted consuming identity; legacy diagnostic rows may be unowned.
  ownerId String? @map("owner_id") @db.Uuid
  owner Owner? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  consumerName String? @map("consumer_name") @db.VarChar(128)
  dedupeKey String? @map("dedupe_key") @db.Char(64)
  messageId String? @map("message_id") @db.Uuid
  messageHash String @map("message_hash") @db.Char(64)
  errorCode String @map("error_code") @db.VarChar(64)
  safeMetadata Json @map("safe_metadata") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageHash, createdAt])
  @@unique([ownerId, consumerName, dedupeKey])
  @@map("quarantine")
}

// T7 synthetic node outputs; schema/version/operation identity remains explicit.
model NodeArtifact {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  taskType TaskType @map("task_type")
  taskId String @map("task_id") @db.Uuid
  analysisTaskId String? @map("analysis_task_id") @db.Uuid
  jobIndexTaskId String? @map("job_index_task_id") @db.Uuid
  analysisTask AnalysisTask? @relation(fields: [ownerId, analysisTaskId], references: [ownerId, id], onDelete: Restrict)
  jobIndexTask JobIndexTask? @relation(fields: [ownerId, jobIndexTaskId], references: [ownerId, id], onDelete: Restrict)
  operationKey String @unique @map("operation_key") @db.Char(64)
  node String @db.VarChar(64)
  inputHash String @map("input_hash") @db.Char(64)
  componentVersion String @map("component_version") @db.VarChar(64)
  schemaVersion Int @map("schema_version")
  fenceToken BigInt @map("fence_token")
  validatedOutput Json @map("validated_output") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId, taskType, taskId])
  @@map("node_artifact")
}

// Explicit synthetic version target for T7. This is not a Job/JobVersion business implementation.
model SyntheticIndexTarget {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  jobVersionId String @map("job_version_id") @db.Uuid
  embeddingVersion String @map("embedding_version") @db.VarChar(64)
  indexVersion String @map("index_version") @db.VarChar(64)
  status String @default("PENDING") @db.VarChar(16)
  completedByTaskId String? @map("completed_by_task_id") @db.Uuid

  @@unique([ownerId, id])
  @@map("synthetic_index_target")
}
