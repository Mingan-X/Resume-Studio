{
  "name": "resume-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "pnpm run build && node scripts/openapi.mjs",
    "openapi:check": "pnpm run build && node scripts/openapi.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "start:api": "node --env-file-if-exists=.env dist/src/main-api.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/main-worker.js",
    "infra:init": "node scripts/infra-init.mjs",
    "infra:provision": "node --env-file=infra/.env scripts/infra-provision.mjs",
    "infra:config": "docker compose --env-file infra/.env -f infra/compose.yaml config --quiet",
    "infra:up": "node scripts/infra-compose.mjs up",
    "infra:stop": "node scripts/infra-compose.mjs stop",
    "db:generate": "node --env-file=infra/.env scripts/prisma.mjs generate",
    "db:deploy": "node --env-file=infra/.env scripts/prisma.mjs deploy",
    "db:status": "node --env-file=infra/.env scripts/prisma.mjs status",
    "db:validate": "node --env-file=infra/.env scripts/prisma.mjs validate",
    "storage:reclaim": "node --env-file=infra/.env --env-file-if-exists=.env dist/src/infrastructure/storage/cli.js",
    "outbox:setup": "node --env-file=infra/.env dist/src/infrastructure/outbox/cli.js setup",
    "outbox:publish": "node --env-file=infra/.env dist/src/infrastructure/outbox/cli.js publish",
    "tasks:consume": "node --env-file=infra/.env dist/src/infrastructure/consumer/cli.js",
    "tasks:consume:graph": "node --env-file=infra/.env --env-file=infra/.env.checkpoint dist/src/infrastructure/consumer/cli.js analysis checkpoint",
    "tasks:reconcile": "node --env-file=infra/.env dist/src/infrastructure/reconciliation/cli.js",
    "test:integration": "pnpm run build && node --env-file=infra/.env --env-file=infra/.env.checkpoint --env-file=infra/.env.observability --test --test-concurrency=1 dist/test/integration/*.test.js",
    "test:integration:native-qdrant": "pnpm run build && node --env-file=infra/.env --env-file=infra/.env.checkpoint --env-file=infra/.env.observability --env-file=infra/.env.qdrant-native --test --test-concurrency=1 dist/test/integration/*.test.js",
    "infra:persistence": "node --env-file=infra/.env dist/test/integration/persistence.fixture.js",
    "checkpoint:init": "node scripts/checkpoint-init.mjs",
    "checkpoint:provision": "node --env-file=infra/.env --env-file=infra/.env.checkpoint dist/src/infrastructure/checkpoint/cli.js provision",
    "checkpoint:setup": "node --env-file=infra/.env --env-file=infra/.env.checkpoint dist/src/infrastructure/checkpoint/cli.js setup",
    "observability:init": "node scripts/observability-init.mjs",
    "observability:config": "docker compose --env-file infra/.env --env-file infra/.env.observability -f infra/compose.yaml -f infra/compose.observability.yaml --profile observability config --quiet",
    "observability:up": "node scripts/observability-compose.mjs up",
    "observability:stop": "node scripts/observability-compose.mjs stop",
    "observability:pull": "node scripts/observability-compose.mjs pull",
    "observability:status": "node scripts/observability-compose.mjs status"
  },
  "dependencies": {
    "@langchain/core": "1.5.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@langchain/langgraph-checkpoint-postgres": "1.1.4",
    "@langfuse/core": "6.1.1",
    "@langfuse/langchain": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/otlp-transformer": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@qdrant/js-client-rest": "1.20.0",
    "@standard-schema/spec": "1.1.0",
    "amqplib": "2.4.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.6.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
